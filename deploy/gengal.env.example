# Copy to /etc/gengal/gengal.env on the server, fill in, then lock it down:
#     sudo install -d -m 0750 /etc/gengal
#     sudo chown root:gengal /etc/gengal
#     sudo chmod 0640 /etc/gengal/gengal.env
#     sudo chown root:gengal /etc/gengal/gengal.env
#
# systemd EnvironmentFile syntax, NOT shell: no `export`, no command
# substitution, and quotes are taken literally unless they wrap the whole
# value. Never commit the filled-in version.

# --- Runtime -----------------------------------------------------------------
# Must be exactly `production` (or `prod`). assert_safe_production_config()
# only enforces the auth-bypass checks when this is set, so a typo here means
# the guards silently do nothing.
APP_ENV=production

# waitress reads neither of these -- the port is passed on the command line in
# the unit file. PORT is here only because app.py's __main__ block reads it,
# which production never executes.
PORT=5055

# --- Firebase ----------------------------------------------------------------
# Path to the service account JSON. Do NOT inline the JSON here: systemd strips
# the backslashes from unquoted values, which corrupts the private key and
# leaves Firebase uninitialised (every sign-in then fails with lookup_failed).
#     sudo install -m 0640 -o root -g gengal serviceAccountKey.json /etc/gengal/firebase-sa.json
FIREBASE_CREDENTIALS_FILE=/etc/gengal/firebase-sa.json

# --- Agora (RTC tokens) ------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Payments ----------------------------------------------------------------
# Leave PAYMENT_PROVIDER empty to keep top-ups disabled; the coin-order
# endpoint returns 501 rather than pretending to work.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public HTTPS origin of THIS server, no trailing slash. require_env() throws
# if it is missing, so the payment route 500s without it.
PUBLIC_BASE_URL=https://api.example.com

# --- Admin -------------------------------------------------------------------
# Comma-separated Firebase UIDs allowed to hit the admin endpoints.
ADMIN_UIDS=

# --- CORS --------------------------------------------------------------------
# Comma-separated origins. Empty means "*", which is acceptable for a native
# app (every request is authenticated with a Firebase ID token and there are no
# cookies to steal), but set it if you ever serve a browser client.
CORS_ALLOWED_ORIGINS=

# --- Zego (only if used) -----------------------------------------------------
ZEGO_SERVER_SECRET=

# --- Development escape hatches: MUST stay false or unset --------------------
# The app refuses to boot in production with any of these set to true.
ALLOW_DEV_OTP_BYPASS=false
FLASK_DEBUG=false

# --- Reverse-OTP sign-in -------------------------------------------------------
# Users text "GENGAL <code>" to this number from their own phone. It is the SIM
# in the gateway Android phone, in +91 format.
SMS_GATEWAY_NUMBER=
# The gateway app's webhook signing key (Settings -> Webhooks -> Signing Key).
# Sign-in returns 503 until both of these are set.
SMS_GATEWAY_SIGNING_KEY=
# Only with the "SMS to URL Forwarder" app (see deploy/sms-gateway-setup.sh):
# the SIM slot users text (sim1/sim2), and the token in its heartbeat URL.
SMS_GATEWAY_SIM=
SMS_GATEWAY_HEARTBEAT_TOKEN=

# --- Reverse-OTP over WhatsApp (Meta WhatsApp Cloud API) -----------------------
# Users can send the same code on WhatsApp instead of SMS; it reaches Meta, not
# the gateway phone, so it keeps sign-in up when that phone is offline.
# Offered only when ALL FIVE are set. Set them with
#     sudo bash /opt/gengal/deploy/whatsapp-setup.sh
# rather than by hand: it types the secrets hidden and checks the token.
WHATSAPP_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
