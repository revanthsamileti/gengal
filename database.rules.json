{
  "rules": {
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'at']) && newData.child('online').isBoolean()"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
