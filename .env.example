# Copy to .env for local development.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time. For release
# builds set this in the EAS project's environment variables to a stable HTTPS
# origin — a dev tunnel URL (trycloudflare / ngrok / localtunnel) will stop
# working as soon as the tunnel closes, permanently breaking that build.
EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com
