rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // An offer in /incoming_calls that nobody is waiting on any more: already
    // answered or declined, or left ringing for longer than any caller waits.
    // Mirrors OFFER_EXPIRY_MS in src/services/liveRoomService.ts.
    function offerIsStale() {
      // Every clause guards its own field first: a missing key is an evaluation
      // error, and an error denies the whole write -- which here would mean a
      // half-written offer document could lock a receiver out of being called.
      return !('status' in resource.data)
        || resource.data.status != 'calling'
        || !('timestamp' in resource.data)
        || resource.data.timestamp == null
        || request.time > resource.data.timestamp + duration.value(60, 's');
    }

    // Whether someone is mid-call, from the one signal a client cannot forge:
    // `inCallSince` is written only by the billing endpoint, from the server's
    // own clock, and is refreshed for as long as the call runs. It expires on
    // its own (mirrors CALL_BUSY_TTL_MS in src/services/userService.ts) so a
    // call that ends in a crash cannot leave someone permanently uncallable.
    //
    // The client checks this too, before it even opens the call screen, but it
    // deliberately fails open on a read error and cannot see the case where two
    // people dial the same idle person in the same instant. This is the copy
    // that actually holds.
    function receiverIsOnCall(receiverId) {
      return exists(/databases/$(database)/documents/users/$(receiverId))
        && get(/databases/$(database)/documents/users/$(receiverId))
             .data.get('inCallSince', request.time - duration.value(1, 'h'))
           > request.time - duration.value(45, 's');
    }

    // Public profile fields only. Phone numbers and push tokens live in
    // /user_private, password material in /user_credentials, because a document
    // that any signed-in user can read must not carry private data.
    function userCreateKeys() {
      return [
        'uid',
        'language',
        'country',
        'state',
        'city',
        'nickname',
        'username',
        'age',
        'gender',
        'bio',
        'avatarUrl',
        'avatar3dUrl',
        'avatarData',
        'coins',
        'hearts',
        'respectBadges',
        'unrewardedCallSeconds',
        'totalReceivedCallSeconds',
        'tier',
        'isOnline',
        'isActiveMode',
        'isSessionActive',
        'pushReachable',
        'following',
        'createdAt',
        'lastActive'
      ];
    }

    function userMutableKeys() {
      return [
        'language',
        'country',
        'state',
        'city',
        'nickname',
        'username',
        'age',
        'gender',
        'bio',
        'avatarUrl',
        'avatar3dUrl',
        'avatarData',
        'isOnline',
        'isActiveMode',
        'isSessionActive',
        'pushReachable',
        'following',
        'lastActive'
      ];
    }

    function privilegedFields() {
      return ['password', 'passwordHash', 'phoneNumber', 'expoPushToken', 'fcmToken'];
    }

    // On create, the document must not contain any privileged field at all.
    function noPrivilegedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(privilegedFields());
    }

    // On update, only the *changed* keys are inspected. Checking the whole
    // document would lock existing accounts out of editing their profile
    // entirely, because pre-migration documents still carry phoneNumber.
    function noPrivilegedFieldsChanged() {
      return !changedKeys().hasAny(privilegedFields());
    }

    // A chat id is `uidA_uidB` with the two uids sorted (see getChatId), and
    // Firebase uids never contain an underscore, so splitting the id recovers
    // the pair exactly. Checking it first is both cheaper and stricter than the
    // stored array: it needs no `get()` — which bills as a document read on
    // every message query — and it is derived from the path rather than from a
    // `participants` field that a client wrote.
    //
    // It is also what makes a brand-new conversation work at all. The old
    // version went straight to `get()`, and on a chat whose parent document did
    // not exist yet that returned null, so `.data.participants` dereferenced
    // null and denied. Reading gave "Could not load messages. Check your
    // connection." on every first-time chat, and writing was worse: the parent
    // was created in the same atomic batch as the first message, so the denied
    // message write rolled back the very document that would have allowed it.
    //
    // The `get()` arm is kept for group or renamed conversations, whose members
    // cannot be derived from a two-uid id.
    function participantInChat(chatId) {
      return signedIn()
        && (chatId.split('_').hasAny([request.auth.uid])
            || get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]));
    }

    // Ownership and pricing fields on a room may only ever be set by its host.
    // Everything else (membership counts, queues, turn state) is writable by
    // participants, which is what the gameplay clients actually need.
    function roomProtectedKeys() {
      return ['hostUid', 'createdAt', 'ticketPrice', 'ratePerMin', 'gameMode', 'tier', 'status'];
    }

    /** Reads a field off a room document, for subcollection rules. */
    function roomField(collectionName, roomId, field) {
      return get(/databases/$(database)/documents/$(collectionName)/$(roomId)).data[field];
    }

    function canUpdateRoom() {
      return signedIn() && (
        resource.data.hostUid == request.auth.uid
        || !changedKeys().hasAny(roomProtectedKeys())
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userCreateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.coins == 500
        && request.resource.data.hearts == 0
        && request.resource.data.respectBadges == 0
        && noPrivilegedFieldsOnCreate();
      allow update: if isOwner(userId)
        && changedKeys().hasOnly(userMutableKeys())
        && noPrivilegedFieldsChanged();
      allow delete: if isOwner(userId);

      // One document per follower, id = follower uid, so a user can only ever
      // add or remove themselves from someone else's follower list.
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isOwner(followerUid)
          && request.resource.data.uid == followerUid;
        allow delete: if isOwner(followerUid);
        allow update: if false;
      }
    }

    // Owner-only. Holds phoneNumber and expoPushToken; the backend reads it via
    // the Admin SDK when it needs to deliver a push or look up an account.
    match /user_private/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User reports. Clients may file one about someone else and nothing more:
    // reports are reviewed from the console, and a reporter must never be
    // able to read (or learn about) reports filed by or against anyone.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetUid', 'reason', 'source', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 60
        && request.resource.data.source in ['profile', 'chat', 'call']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Password hashes. Server-side only, in both directions.
    match /user_credentials/{userId} {
      allow read, write: if false;
    }

    match /incoming_calls/{receiverId} {
      // The `resource == null` arm is what makes the caller's status listener
      // work at all. The caller subscribes to the *receiver's* document to learn
      // when its offer is answered, so `request.auth.uid == receiverId` is false
      // for it and evaluation falls through to `resource.data.callerUid`. On a
      // document that does not exist -- the normal state both before
      // createCallOffer's write lands and again the instant either side clears
      // the offer -- there is no `resource`, so that dereference denied the read
      // and the SDK tore the listener down permanently. The caller then never
      // learned the call had been accepted and sat on "Ringing..." until the
      // ring timeout fired. Reading a document that does not exist discloses
      // nothing, and the ownership arms below still apply the moment it exists.
      allow read: if signedIn()
        && (request.auth.uid == receiverId
            || resource == null
            || resource.data.callerUid == request.auth.uid);
      // `resource == null` matters here for the same reason it does on read, and
      // its absence was observed in the wild: both sides run clearCallOffer when
      // a call ends, so whichever one lands second is deleting a document that
      // no longer exists. That dereferenced a null `resource`, Firestore denied
      // it, and the caller logged "Failed to clear call offer on end call" --
      // leaving exactly the orphaned offers this rule set is meant to prevent.
      // Deleting something that is already gone is a no-op, not a privilege.
      allow delete: if signedIn()
        && (request.auth.uid == receiverId
            || resource == null
            || resource.data.callerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.receiverUid == receiverId
        && !receiverIsOnCall(receiverId);
      // acceptCallOffer/rejectCallOffer are merge writes by the *receiver*, and
      // for a merge write `request.resource.data` is the full post-merge
      // document -- so callerUid there is still the original caller's uid, not
      // the receiver's. The receiver-or-original-caller clause is what makes
      // those writes legal.
      //
      // The third clause lets a *new* caller take over the slot, and its
      // conditions are the only defence the first caller has. A client cannot
      // read an offer belonging to somebody else -- the read rule above sees to
      // that, and rightly, since the document carries a third party's name,
      // avatar and room id -- so no caller can judge for itself whether the
      // line is free. This rule is where that judgement has to live.
      //
      // It used to be an unconditional "last call wins", which meant a second
      // caller silently destroyed the first caller's live offer in place. The
      // first caller kept watching a document that was now a stranger's call;
      // the receiver rang for one person and answered another; and a call that
      // was already in progress could be hung up by a third party who never got
      // through. Requiring the receiver to be free and the existing offer to be
      // stale closes all of that, while keeping the property that made the
      // unconditional version attractive: an offer abandoned by a crash still
      // ages out, so nobody is ever permanently unreachable.
      allow update: if signedIn()
        && (
          request.auth.uid == receiverId || resource.data.callerUid == request.auth.uid
          || (request.resource.data.callerUid == request.auth.uid
              && request.resource.data.receiverUid == receiverId
              && !receiverIsOnCall(receiverId)
              && offerIsStale())
        );
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow read, update, delete: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if participantInChat(chatId);
        allow create: if participantInChat(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      // Typing indicators. One document per participant, keyed by uid, so a
      // participant can only ever assert that *they* are typing — never put
      // words in the other person's mouth. The document holds a timestamp and
      // nothing else; readers expire it, so a sender who vanishes mid-word
      // cannot leave the indicator stuck on.
      match /typing/{typerUid} {
        allow read: if participantInChat(chatId);
        allow write: if participantInChat(chatId) && request.auth.uid == typerUid;
      }
    }

    // Call history. Opened by the caller, readable and closable by either party.
    match /calls/{callId} {
      // Same not-exists arm as /incoming_calls above, for the same reason: both
      // sides subscribe to this record to stay in sync on provider fallbacks,
      // and the receiver reliably subscribes before the caller's openCallRecord
      // write has landed. Without it that listener was denied on its first
      // evaluation and dropped, so a mid-call fallback never reached the peer.
      allow read: if signedIn()
        && (resource == null
            || resource.data.callerUid == request.auth.uid
            || resource.data.receiverUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.callerUid == request.auth.uid
            || resource.data.receiverUid == request.auth.uid)
        && !changedKeys().hasAny(['callerUid', 'receiverUid', 'createdAt']);
      allow delete: if false;
    }

    // Pricing and payout rates. Written only by the backend admin endpoint.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Open and settled coin top-ups. Written only by the Admin SDK, and closed
    // to clients in both directions: a readable order would leak the frozen
    // coin yield, and a writable one would let a client mark itself paid.
    match /coin_orders/{orderId} {
      allow read, write: if false;
    }

    // Sign-in audit trail, written only by the backend's Admin SDK.
    match /auth_events/{eventId} {
      allow read, write: if false;
    }

    // Payout requests awaiting manual review. A user may file their own and
    // read it back, but never approve it: status is fixed to "pending" on
    // create and the client cannot update or delete afterwards.
    match /withdrawalRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      // Created only by /api/v1/withdrawals/request, which runs on the Admin SDK
      // and so bypasses these rules entirely.
      //
      // This used to permit a direct client create, validating that `hearts` was
      // a number greater than zero — and nothing else. It never compared that
      // number to what the user had actually earned, so a patched client could
      // claim any payout it wanted, and nothing stopped a second request being
      // opened beside the first. Hearts convert to rupees via `heartToInrRate`,
      // so those were live revenue leaks rather than cosmetic gaps. The server
      // now reads the real balance in a transaction, prices the payout itself,
      // and deducts the hearts as it stakes the claim.
      allow create: if false;
      allow update, delete: if false;
    }

    match /chill_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if canUpdateRoom();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }

      // The round's answer. Only the actor performing it and the host running
      // the game may read it — a guesser subscribing here is denied, which is
      // the entire point of moving it off the shared room document.
      match /private/{docId} {
        allow read: if signedIn() && (
          roomField('chill_rooms', roomId, 'actorUid') == request.auth.uid
          || roomField('chill_rooms', roomId, 'hostUid') == request.auth.uid
        );
        allow write: if signedIn()
          && roomField('chill_rooms', roomId, 'hostUid') == request.auth.uid;
      }

      // Heartbeat presence. A client may only assert its own presence, and the
      // host may evict. Nothing billable is stored here — Chill rooms are free
      // to sit in — so unlike expert_rooms there are no protected fields.
      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(memberUid);
        allow delete: if isOwner(memberUid)
          || roomField('chill_rooms', roomId, 'hostUid') == request.auth.uid;
      }
    }

    match /expert_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if canUpdateRoom();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Gift leaderboard, keyed by sender.
      match /gifters/{gifterUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(gifterUid);
        allow delete: if false;
      }

      // A user may only raise or lower their own hand; the host may clear one.
      match /hand_requests/{requesterUid} {
        allow read: if signedIn();
        allow create: if isOwner(requesterUid);
        allow delete: if isOwner(requesterUid)
          || roomField('expert_rooms', roomId, 'hostUid') == request.auth.uid;
        allow update: if false;
      }

      // Membership drives per-minute billing. Clients create and remove their
      // own record, but the billing fields are written only by the backend
      // through the Admin SDK.
      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if isOwner(memberUid)
          && !request.resource.data.keys().hasAny(['lastBilledAt', 'coinsSpent', 'secondsInRoom']);
        allow update: if isOwner(memberUid)
          && !changedKeys().hasAny(['lastBilledAt', 'coinsSpent', 'secondsInRoom']);
        allow delete: if isOwner(memberUid)
          || roomField('expert_rooms', roomId, 'hostUid') == request.auth.uid;
      }
    }

    // public_rooms intentionally has no rules: the "go live and take call
    // requests" feature was never built (every service function was dead code
    // with no call sites). Default-deny is correct until it exists — leaving an
    // open rule for a collection nothing reads is pure downside.

    match /ludo_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if canUpdateRoom();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Heartbeat presence, covering players and spectators alike. Seats and
      // stakes live on the room's `players` array and are not affected by this
      // — a player who briefly drops offline keeps their seat.
      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(memberUid);
        allow delete: if isOwner(memberUid)
          || roomField('ludo_rooms', roomId, 'hostUid') == request.auth.uid;
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.host.uid == request.auth.uid || request.resource.data.guest.uid == request.auth.uid);
      allow update, delete: if signedIn()
        && (resource.data.host.uid == request.auth.uid || resource.data.guest.uid == request.auth.uid);
      // No subcollections are used under a matchmaking room; default-deny.
    }

    match /matchmaking_pool/{docId} {
      allow read: if signedIn();
      allow create, update: if isOwner(docId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(docId);

      // A second searcher claims this entry to pair up. Only the pairing fields
      // may change, and only out of the 'searching' state, so an entry cannot be
      // hijacked or rewritten by a third party.
      allow update: if signedIn()
        && resource.data.status == 'searching'
        && request.resource.data.status == 'matched'
        && request.resource.data.uid == resource.data.uid
        && changedKeys().hasOnly(['status', 'matchedRoomId']);
    }
  }
}
